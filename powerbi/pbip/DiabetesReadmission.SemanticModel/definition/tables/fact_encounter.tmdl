table fact_encounter
	lineageTag: 1070f709-0e4a-489b-b331-e6209c9883b0

	measure Encounters = COUNTROWS ( fact_encounter )
		formatString: #,0
		lineageTag: 7505ec66-7a41-41f1-8ed2-9f24308389d9

	measure Patients = DISTINCTCOUNT ( fact_encounter[patient_nbr] )
		formatString: #,0
		lineageTag: 5d879f3b-8645-4c8e-997e-35418d218f5c

	measure 'Eligible Encounters' = CALCULATE ( COUNTROWS ( fact_encounter ), fact_encounter[is_eligible] = 1 )
		formatString: #,0
		lineageTag: 4c0a6abb-24b5-4864-8d93-800aa3f86bee

	measure 'Readmitted <30' = CALCULATE ( SUM ( fact_encounter[readmit_lt30] ), fact_encounter[is_eligible] = 1 )
		formatString: #,0
		lineageTag: 13c1de89-b2b8-456e-85f7-17caa2ec907f

	measure '30-Day Readmission Rate' = DIVIDE ( [Readmitted <30], [Eligible Encounters] )
		formatString: 0.0%
		lineageTag: 692e2ded-1779-457e-b296-bb38b875f541

	measure 'Readmission Rate >30' = DIVIDE ( CALCULATE ( SUM ( fact_encounter[readmit_gt30] ), fact_encounter[is_eligible] = 1 ), [Eligible Encounters] )
		formatString: 0.0%
		lineageTag: 22eed20e-326b-4485-aa76-9e858b304474

	measure 'Any Readmission Rate' = DIVIDE ( CALCULATE ( SUM ( fact_encounter[readmit_any] ), fact_encounter[is_eligible] = 1 ), [Eligible Encounters] )
		formatString: 0.0%
		lineageTag: d95a0c88-5035-41c8-8951-4c39847a1fe7

	measure 'Avg Length of Stay' = AVERAGE ( fact_encounter[los_days] )
		formatString: 0.0
		lineageTag: 14ad7501-bf45-4cd3-943b-7dd4f46eb60a

	measure 'Median Length of Stay' = MEDIAN ( fact_encounter[los_days] )
		formatString: 0.0
		lineageTag: b45f2d5c-a813-4059-b077-a049d59603c4

	measure '30-Day Rate (All Patients)' = CALCULATE ( [30-Day Readmission Rate], REMOVEFILTERS ( fact_encounter ) )
		formatString: 0.0%
		lineageTag: 5be06d8c-ca38-4a6c-9401-d8d884d3a2ab

	measure '30-Day Rate vs Average' = [30-Day Readmission Rate] - [30-Day Rate (All Patients)]
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: c5769087-60da-4e22-b57e-f653df538527

	measure '30-Day Rate (n>=200)' = IF ( [Eligible Encounters] >= 200, [30-Day Readmission Rate] )
		formatString: 0.0%
		lineageTag: 0e2049ab-e7fd-46ed-8752-3fa0208eb9df

	measure Prescriptions = COUNTROWS ( fact_medication )
		formatString: #,0
		lineageTag: 5e542d43-3853-4875-b0c1-4f6066691270

	measure 'HbA1c Tested Share' = DIVIDE ( CALCULATE ( [Encounters], fact_encounter[a1c_result] <> "Not measured" ), [Encounters] )
		formatString: 0.0%
		lineageTag: 36968584-4faa-40b3-adb4-76c4a3e82428

