	partition fact_encounter = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_encounter.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"encounter_id", Int64.Type}, {"patient_nbr", Int64.Type}, {"race", type text}, {"gender", type text}, {"age_band", type text}, {"age_order", Int64.Type}, {"admission_type_id", Int64.Type}, {"admission_type", type text}, {"admission_type_group", type text}, {"discharge_disposition_id", Int64.Type}, {"discharge_disposition", type text}, {"discharge_group", type text}, {"admission_source_id", Int64.Type}, {"admission_source", type text}, {"admission_source_group", type text}, {"los_days", Int64.Type}, {"payer_code", type text}, {"medical_specialty", type text}, {"num_lab_procedures", Int64.Type}, {"num_procedures", Int64.Type}, {"num_medications", Int64.Type}, {"number_outpatient", Int64.Type}, {"number_emergency", Int64.Type}, {"number_inpatient", Int64.Type}, {"prior_inpatient_band", type text}, {"diag_1", type text}, {"diag_2", type text}, {"diag_3", type text}, {"primary_diag_group", type text}, {"number_diagnoses", Int64.Type}, {"max_glu_serum", type text}, {"a1c_result", type text}, {"insulin", type text}, {"med_changed", Int64.Type}, {"on_diabetes_med", Int64.Type}, {"readmitted_raw", type text}, {"readmit_lt30", Int64.Type}, {"readmit_gt30", Int64.Type}, {"readmit_any", Int64.Type}, {"is_eligible", Int64.Type}, {"is_first_encounter", Int64.Type}})
